# 1. Dependencias de Node.js
node_modules/
.pnp
.pnp.js

# 2. Archivos de compilación de producción (Vite / Vue)
dist/
dist-ssr/
*.local

# 3. Datos temporales de Vercel CLI
.vercel/

# 4. Archivos pesados de Rust / Tauri (¡Crítico! La carpeta target pesa gigas)
src-tauri/target/
src-tauri/Cargo.lock

# 5. Archivos pesados de la NASA (LOLA DEM crudo de 145 MB)

# ==============================================================================
# L-SEA - .gitignore
# ==============================================================================

# 1. Node.js dependencies
node_modules/
.pnp
.pnp.js

# 2. Production build output (Vite / Vue)
dist/
dist-ssr/
*.local

# 3. Temporary files (preview renders, one-off scripts)
tmp/

# 3b. Vercel CLI state (project and org ids live here; the deployment is rebuilt from source)
.vercel/

# 4. Rust / Tauri build artifacts (src-tauri/target is several GB)
src-tauri/target/
src-tauri/Cargo.lock

# 5. NASA source data (raw 145 MB LOLA DEM; GitHub rejects files over 100 MB)
ldem_80s_80m.img
*.img

# 6. Python cache
__pycache__/
*.py[cod]
*$py.class
.venv/
env/

# 7. Secret environment files
.env
.env.*
!.env.example

# 8. OS and editor litter
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
graphify-out/

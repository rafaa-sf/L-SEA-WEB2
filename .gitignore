ldem_80s_80m.img
*.img

# 6. Caché de Python
__pycache__/
*.py[cod]
*$py.class
.venv/
env/

# 7. Variables de entorno secretas (API keys, etc.)
.env
.env.*
!.env.example

# 8. Archivos basura de sistemas operativos y editores
